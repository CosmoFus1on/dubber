# Copy to .env and fill in. Never commit .env.
DUBBER_LLM_BASE_URL=http://localhost:31415/v1
DUBBER_LLM_KEY=
# pinned translation model id from the proxy catalog (GET /v1/models); leave empty to auto-pick
DUBBER_LLM_MODEL=
# Hugging Face fine-grained token: scope "Read access to contents of all public gated repos you can access"
# (needed for pyannote/speaker-diarization-community-1). Add "Write access to Spaces" only for the demo deploy.
HF_TOKEN=
